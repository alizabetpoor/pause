# Optional verified HTTPS production origin. Used at build time for canonical URLs,
# Open Graph metadata, JSON-LD, robots.txt and sitemap.xml. Public, not a secret.
# Changing it requires rebuilding the Docker image. Leave blank for local builds.
SITE_URL=

# VPS only: host loopback port for the reverse proxy to connect to (default 3000).
# This is Compose configuration, not a Next.js application runtime variable.
APP_PORT=3000
